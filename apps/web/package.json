{
  "name": "@sellora/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "brand:build": "node scripts/generate-brand.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.pg.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/server/db/seed.ts",
    "app:assets": "node scripts/make-app-assets.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@resvg/resvg-js": "^2.6.2",
    "@sellora/shared": "workspace:*",
    "@sellora/ui": "workspace:*",
    "better-auth": "^1.7.10",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "passkit-generator": "^3.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "selfsigned": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
