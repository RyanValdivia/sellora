# URL del servidor (apps/web). En el emulador de Android el PC es 10.0.2.2; en un celular real usa la IP
# de tu PC en la red local o un túnel https (cloudflared/ngrok).
VITE_API_URL=http://localhost:3000
# URL pública que se imprime en el QR (por defecto, igual a VITE_API_URL).
# VITE_PUBLIC_URL=https://tarjetas.tudominio.com

# Notificaciones de la app del cliente. Actívalas solo cuando el proyecto Android tenga google-services.json
# (ver docs/push.md); sin él la app se cierra al pedir el token.
# VITE_PUSH_ENABLED=true
