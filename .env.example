# ─────────────────────────────────────────────────────────────
#  Sellora — variables de entorno
#  Copia este archivo a .env.local y ajusta lo que necesites.
#  Se validan con zod al arrancar (src/lib/env.ts).
# ─────────────────────────────────────────────────────────────

# URL pública de la app (sin barra final). Se usa en QR, enlaces e imágenes OG.
# En producción debe ser https. Para probar en el celular usa un túnel (cloudflared/ngrok).
APP_URL=http://localhost:3000

# Base de datos. SQLite local por defecto; para Postgres usa postgres://usuario:clave@host:5432/sellora
# y ejecuta `pnpm --filter @sellora/web db:migrate`. El driver se elige solo por el prefijo.
DATABASE_URL=file:./data/sellora.db

# Secreto de Better Auth (mínimo 32 caracteres). Genera uno: openssl rand -base64 32
# En producción es obligatorio cambiarlo.
BETTER_AUTH_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

# Orígenes de las apps (Vite y Capacitor) autorizados a llamar a la API, separados por comas.
TRUSTED_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,http://localhost

# ── Apple Wallet (opcional) ─────────────────────────────────────────────────
# Sin certificados la app corre en modo VISTA PREVIA: genera el .pkpass completo pero un iPhone lo rechaza.
# Cómo conseguirlos y convertirlos a PEM: docs/apple-wallet.md
APPLE_PASS_TYPE_ID=pass.app.sellora.dev
APPLE_TEAM_ID=DEVTEAM000
# APPLE_WWDR_CERT_PATH=./certs/wwdr.pem
# APPLE_SIGNER_CERT_PATH=./certs/signerCert.pem
# APPLE_SIGNER_KEY_PATH=./certs/signerKey.pem
# APPLE_SIGNER_KEY_PASSPHRASE=

# ── Notificaciones a la app del cliente (opcional) ──────────────────────────
# JSON de la cuenta de servicio de Firebase (Project settings → Service accounts). Ver docs/push.md.
# FCM_SERVICE_ACCOUNT_PATH=./certs/firebase-service-account.json
